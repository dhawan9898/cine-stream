<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP has to stay allowed: streams come from many third-party hosts, some of them http-only,
     and a self-hosted Jellyfin server is usually reached as http://192.168.x.x - an address this
     file cannot list (it takes host names, not address ranges). Only system certificates are trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
